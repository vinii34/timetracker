<Window x:Class="TimeTracker.UI.CalendarPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeTracker"
        Width="400" SizeToContent="Height"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#FAFAFA">
    <StackPanel Margin="18">
        <TextBlock x:Name="HeaderText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="CurrentText" FontSize="12" Foreground="#666" Margin="0,6,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <!-- Un bouton par créneau : le sujet en gras, l'horaire et la réponse Outlook dessous.
             Avec un seul créneau, le bouton se lit comme un « Oui ». -->
        <ItemsControl x:Name="CandidateList" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Margin="0,0,0,6" Padding="12,8" HorizontalContentAlignment="Left"
                            Click="Candidate_Click" Tag="{Binding}">
                        <StackPanel>
                            <TextBlock Text="{Binding Prompt}" FontSize="13" FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#666"
                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="HintText" FontSize="11" Foreground="#888" Margin="0,4,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="NoButton" Padding="12,5" Click="No_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
