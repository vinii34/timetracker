<Window x:Class="TimeTracker.UI.TaskSelectorPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeTracker"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#FAFAFA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Sur quelle tâche travailles-tu ?"
                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button x:Name="StartButton" DockPanel.Dock="Right" Content="Démarrer"
                    Padding="14,6" Margin="8,0,0,0" Click="StartNew_Click"/>
            <TextBox x:Name="NewTaskBox" VerticalContentAlignment="Center" Padding="6,4"
                     KeyDown="NewTaskBox_KeyDown"/>
        </DockPanel>

        <TextBlock Grid.Row="2" Text="Nouvelle tâche — ou choisis ci-dessous (chiffres 1-9 ; 💡 = suggérée d'après tes fenêtres)"
                   Foreground="#888" FontSize="11" Margin="2,0,0,10" TextWrapping="Wrap"/>

        <ListBox x:Name="RecentList" Grid.Row="3" MaxHeight="260"
                 MouseDoubleClick="RecentList_DoubleClick"
                 KeyDown="RecentList_KeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Margin="2" ToolTip="{Binding Tip, Mode=OneWay}">
                        <Run Text="{Binding Shortcut, Mode=OneWay}" FontWeight="Bold" Foreground="#2D7DD2"/>
                        <Run Text=" — "/>
                        <Run Text="{Binding Display, Mode=OneWay}"/>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Proposé après un rappel : l'utilisateur a pu changer de sujet avant de le déclarer. -->
        <Border x:Name="BackdatePanel" Grid.Row="4" Visibility="Collapsed"
                BorderBrush="#DDD" BorderThickness="1" CornerRadius="4"
                Background="White" Padding="10,8" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Cette tâche a commencé…" FontSize="12" Foreground="#555"
                           Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="BackdateNow" Content="maintenant" IsChecked="True"
                                 Margin="0,0,14,0" VerticalContentAlignment="Center"/>
                    <RadioButton x:Name="Backdate5" Content="il y a 5 min"
                                 Margin="0,0,14,0" VerticalContentAlignment="Center"/>
                    <RadioButton x:Name="Backdate15" Content="il y a 15 min"
                                 VerticalContentAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Button Grid.Row="5" Content="Annuler (Échap)" HorizontalAlignment="Right"
                Margin="0,12,0,0" Padding="10,4" Click="Cancel_Click"/>
    </Grid>
</Window>
