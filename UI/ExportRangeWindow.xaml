<Window x:Class="TimeTracker.UI.ExportRangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeTracker — Exporter une période"
        Width="400" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FAFAFA">
    <StackPanel Margin="18">
        <TextBlock Text="Exporter une période" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Du" VerticalAlignment="Center"/>
            <DatePicker Grid.Column="1" x:Name="FromPicker"/>
            <TextBlock Grid.Column="2" Text="au" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <DatePicker Grid.Column="3" x:Name="ToPicker"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Ce mois" Padding="8,3" Margin="0,0,6,0" Click="ThisMonth_Click"/>
            <Button Content="Mois dernier" Padding="8,3" Margin="0,0,6,0" Click="LastMonth_Click"/>
            <Button Content="30 derniers jours" Padding="8,3" Click="Last30_Click"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="#C0392B" TextWrapping="Wrap"
                   Margin="0,0,0,8" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" Padding="12,5" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Exporter CSV…" Padding="12,5" Margin="0,0,8,0" Click="Csv_Click"/>
            <Button Content="Exporter Excel…" Padding="12,5" IsDefault="True" Click="Xlsx_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
