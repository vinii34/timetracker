<Window x:Class="TimeTracker.UI.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeTracker — Tableau de bord"
        Width="820" Height="600" MinWidth="620" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinWidth" Value="30"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- Barre de suivi (haut de fenêtre) : piloter sans passer par le tray -->
        <Border DockPanel.Dock="Top" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4"
                Background="White" Padding="10,8" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="ChangeTaskButton" Style="{StaticResource ActionButton}"
                            Content="🔄 Changer de tâche" Click="ChangeTask_Click"/>
                    <Button x:Name="QuickEditButton" Style="{StaticResource ActionButton}"
                            Content="✏ Corriger" Click="QuickEdit_Click"/>
                    <Button x:Name="PauseButton" Style="{StaticResource ActionButton}"
                            Content="⏸ Pause" Click="TogglePause_Click"/>
                    <Button x:Name="StopButton" Style="{StaticResource ActionButton}"
                            Content="⏹ Arrêter" ToolTip="Fin de la journée de travail"
                            Click="Stop_Click"/>
                    <Button x:Name="ManageTasksButton" Style="{StaticResource ActionButton}"
                            Content="★ Tâches" ToolTip="Gérer la liste des tâches"
                            Click="ManageTasks_Click"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource ActionButton}"
                            Content="⚙" ToolTip="Paramètres" Margin="0" Click="Settings_Click"/>
                </StackPanel>
                <TextBlock x:Name="CurrentTaskText" VerticalAlignment="Center"
                           Margin="2,0,10,0" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Noms à vérifier : fautes de frappe et doublons, là où il regarde (et plus seulement
             au fond de « Gérer les tâches », où il n'allait pas). -->
        <Border x:Name="NamesBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="#FFF8E1" BorderBrush="#F0D890" BorderThickness="1" CornerRadius="4"
                Padding="10,6" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Vérifier…" Padding="10,3" Click="ReviewNames_Click"/>
                <TextBlock x:Name="NamesBannerText" VerticalAlignment="Center" Foreground="#6B5300"
                           TextWrapping="Wrap" Margin="0,0,10,0"/>
            </DockPanel>
        </Border>

        <!-- Barre d'actions (bas de fenêtre) -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="#666" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button x:Name="ExportRangeButton" Content="Autre période…" Padding="12,5"
                        Margin="0,0,8,0" ToolTip="Exporter un mois, ou n'importe quelle plage de dates"
                        Click="ExportRange_Click"/>
                <Button x:Name="ExportCsvButton" Content="Exporter CSV…" Padding="12,5"
                        Margin="0,0,8,0" Click="ExportCsv_Click"/>
                <Button x:Name="ExportXlsxButton" Content="Exporter Excel…" Padding="12,5"
                        Click="ExportXlsx_Click"/>
            </StackPanel>
        </DockPanel>

        <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">

            <!-- ================================================ Jour -->
            <TabItem Header="Jour">
                <Grid Margin="10" SizeChanged="DayGrid_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Détail et totaux se partagent la hauteur, en étoiles tous les deux : c'est la
                             grille qui les borne, et la liste des totaux défile au lieu d'écraser le
                             détail. Les poids sont posés par FitTotals. -->
                        <RowDefinition x:Name="EntriesRow" Height="*" MinHeight="90"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="TotalsRow" Height="0*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button Style="{StaticResource NavButton}" Content="◀" Click="PrevDay_Click"
                                ToolTip="Jour précédent"/>
                        <Button Style="{StaticResource NavButton}" Content="▶" Click="NextDay_Click"
                                ToolTip="Jour suivant"/>
                        <Button Style="{StaticResource NavButton}" Content="Aujourd'hui" Click="Today_Click"/>
                        <TextBlock x:Name="DayHeaderText" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <ListView Grid.Row="1" x:Name="EntriesList"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              MouseDoubleClick="EntriesList_MouseDoubleClick">
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Modifier…" Click="EditEntry_Click"/>
                                <MenuItem Header="Supprimer" Click="DeleteEntry_Click"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <!-- Marqueur de réunion : CellTemplate et non DisplayMemberBinding,
                                     pour porter l'infobulle qui explique le pictogramme. -->
                                <GridViewColumn Header="" Width="26">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Marker, Mode=OneWay}"
                                                       ToolTip="{Binding MarkerTip, Mode=OneWay}"
                                                       HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Début" Width="60"
                                    DisplayMemberBinding="{Binding Start, Mode=OneWay}"/>
                                <GridViewColumn Header="Fin" Width="60"
                                    DisplayMemberBinding="{Binding End, Mode=OneWay}"/>
                                <GridViewColumn x:Name="TaskColumn" Header="Tâche" Width="300"
                                    DisplayMemberBinding="{Binding Name, Mode=OneWay}"/>
                                <GridViewColumn Header="Durée" Width="70"
                                    DisplayMemberBinding="{Binding Duration, Mode=OneWay}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Poignée : un Thumb et non un GridSplitter, qui fixerait des hauteurs en
                         pixels et laisserait du vide sous des totaux plus courts que la zone. -->
                    <Thumb Grid.Row="2" x:Name="TotalsSplitter" Height="10" Margin="0,4,0,0"
                           Cursor="SizeNS" DragDelta="TotalsSplitter_DragDelta"
                           ToolTip="Glisser pour agrandir le détail ou les totaux">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="Transparent">
                                    <Border x:Name="Grip" Width="44" Height="4" CornerRadius="2"
                                            Background="#C8C8C8"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Grip" Property="Background" Value="#8A8A8A"/>
                                    </Trigger>
                                    <Trigger Property="IsDragging" Value="True">
                                        <Setter TargetName="Grip" Property="Background" Value="#5A5A5A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>

                    <TextBlock Grid.Row="3" Text="Total par tâche" FontWeight="SemiBold" Margin="0,2,0,4"/>
                    <ScrollViewer Grid.Row="4" x:Name="TotalsScroll" VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="TotalsScroll_ScrollChanged">
                        <ItemsControl x:Name="TotalsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding Duration, Mode=OneWay}"
                                                   FontWeight="SemiBold" Width="80" TextAlignment="Right"/>
                                        <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="5" x:Name="GrandTotalText" FontWeight="Bold"
                               Margin="0,8,0,0" FontSize="14"/>
                </Grid>
            </TabItem>

            <!-- ============================================== Semaine -->
            <TabItem Header="Semaine">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button Style="{StaticResource NavButton}" Content="◀" Click="PrevWeek_Click"
                                ToolTip="Semaine précédente"/>
                        <Button Style="{StaticResource NavButton}" Content="▶" Click="NextWeek_Click"
                                ToolTip="Semaine suivante"/>
                        <Button Style="{StaticResource NavButton}" Content="Cette semaine" Click="ThisWeek_Click"/>
                        <TextBlock x:Name="WeekHeaderText" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <DataGrid Grid.Row="1" x:Name="WeekGrid"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserSortColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              AlternatingRowBackground="#F4F7FA"
                              AutoGeneratingColumn="WeekGrid_AutoGeneratingColumn"/>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock x:Name="WeekTotalText" FontWeight="Bold" FontSize="14"/>
                        <!-- Objectif hebdomadaire (réglage) : masqué s'il vaut zéro. -->
                        <DockPanel x:Name="GoalPanel" Visibility="Collapsed" Margin="0,6,0,0">
                            <TextBlock x:Name="GoalText" DockPanel.Dock="Right" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Foreground="#555"/>
                            <ProgressBar x:Name="GoalBar" Height="14" Minimum="0" Maximum="100"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
