<Window x:Class="TimeTracker.UI.ReminderPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeTracker"
        Width="360" SizeToContent="Height"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#FAFAFA">
    <StackPanel Margin="18">
        <TextBlock x:Name="QuestionText" Text="Toujours sur cette tâche ?"
                   FontSize="15" FontWeight="SemiBold"/>
        <TextBlock x:Name="TaskNameText" FontSize="14" Margin="0,8,0,4"
                   TextWrapping="Wrap" Foreground="#2D7DD2"/>
        <TextBlock x:Name="DetailText" FontSize="12" Foreground="#777"
                   Margin="0,0,0,16" TextWrapping="Wrap"/>
        <Border x:Name="HintBorder" Background="#FFF8E1" BorderBrush="#F0D890" BorderThickness="1"
                CornerRadius="4" Padding="8,6" Margin="0,-8,0,14"
                Visibility="{Binding Visibility, ElementName=HintText, Mode=OneWay}">
            <TextBlock x:Name="HintText" FontSize="12" Foreground="#6B5300" TextWrapping="Wrap"
                       Visibility="Collapsed"/>
        </Border>

        <!-- Suivi en cours -->
        <StackPanel x:Name="RunningButtons" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="🔄 Non, je change" Padding="12,6" Margin="0,0,8,0"
                    Click="Change_Click"/>
            <Button Content="✅ Oui, je continue" Padding="12,6"
                    IsDefault="True" Click="Continue_Click"/>
        </StackPanel>

        <!-- Suivi en pause -->
        <StackPanel x:Name="PausedButtons" Visibility="Collapsed">
            <Button Content="▶ Reprendre cette tâche" Padding="12,6" Margin="0,0,0,6"
                    IsDefault="True" Click="Resume_Click"/>
            <Button Content="🔄 Démarrer une autre tâche" Padding="12,6" Margin="0,0,0,6"
                    Click="Change_Click"/>
            <Button Content="⏸ Rester en pause" Padding="12,6" Click="StayPaused_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
