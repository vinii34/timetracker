<Window x:Class="TimeTracker.UI.QuickEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeTracker — Correction"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#FAFAFA">
    <StackPanel Margin="20">

        <TextBlock Text="Correction à chaud" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock x:Name="SubtitleText" Foreground="#666" Margin="0,2,0,16"
                   TextWrapping="Wrap"/>

        <!-- ========================================= Tâche en cours -->
        <Border x:Name="CurrentPanel" BorderBrush="#DDD" BorderThickness="1"
                CornerRadius="4" Background="White" Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Tâche en cours" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <TextBlock Text="Nom de la tâche" Margin="0,0,0,4"/>
                <ComboBox x:Name="TaskBox" IsEditable="True" Padding="6,4" Margin="0,0,0,12"/>

                <TextBlock Text="Heure de début" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,6">
                    <Button Content="−15 min" Padding="8,3" Margin="8,0,0,0"
                            DockPanel.Dock="Right" Click="Minus15_Click"/>
                    <Button Content="−5 min" Padding="8,3" Margin="8,0,0,0"
                            DockPanel.Dock="Right" Click="Minus5_Click"/>
                    <TextBox x:Name="StartBox" Padding="6,4"/>
                </DockPanel>
                <TextBlock x:Name="DurationText" Foreground="#555" FontSize="12"/>

                <Button x:Name="CancelEntryButton" Content="Annuler cette entrée (arrêter le suivi)"
                        Padding="10,5" Margin="0,14,0,0" HorizontalAlignment="Left"
                        Click="CancelEntry_Click"/>
            </StackPanel>
        </Border>

        <!-- ================================= Dernière entrée clôturée -->
        <Border x:Name="LastEntryPanel" BorderBrush="#DDD" BorderThickness="1"
                CornerRadius="4" Background="White" Padding="14">
            <StackPanel>
                <TextBlock Text="Dernière entrée terminée" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock x:Name="LastEntryText" TextWrapping="Wrap" Foreground="#333"/>
                <Button x:Name="DeleteLastButton" Content="Supprimer cette entrée"
                        Padding="10,5" Margin="0,12,0,0" HorizontalAlignment="Left"
                        Click="DeleteLast_Click"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="#C0392B" TextWrapping="Wrap"
                   Margin="0,10,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Fermer" Padding="14,5" Margin="0,0,8,0"
                    IsCancel="True" Click="Close_Click"/>
            <Button x:Name="SaveButton" Content="Enregistrer" Padding="14,5"
                    IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
