<Window x:Class="TimeTracker.UI.AiSuggestionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeTracker — Propositions de l'assistant"
        Width="640" Height="480" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FAFAFA">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" x:Name="HeaderText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock DockPanel.Dock="Top" Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10"
                   Text="Coche ce que tu veux appliquer. Rien n'est fait sans ton accord ; une fusion rattache les entrées à l'autre tâche, un renommage corrige aussi l'historique."/>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Fermer sans rien faire" Padding="12,5" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="ApplyButton" Content="Appliquer la sélection" Padding="12,5" IsDefault="True"
                        Click="Apply_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AiButton" Content="✨ Proposer aussi avec l'IA" Padding="10,5"
                        Visibility="Collapsed" Click="Ai_Click"
                        ToolTip="Envoie les noms des tâches (et leur nombre d'entrées) à l'assistant configuré"/>
                <TextBlock x:Name="AiStatusText" Foreground="#777" FontSize="11" Margin="8,0,8,0"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="220"/>
            </StackPanel>
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" x:Name="IgnoredText" Foreground="#777" FontSize="11"
                   TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ProposalList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Margin="0,4">
                            <StackPanel>
                                <TextBlock Text="{Binding Title, Mode=OneWay}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Why, Mode=OneWay}" Foreground="#777" FontSize="11"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
