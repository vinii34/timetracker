<Window x:Class="TimeTracker.UI.EntryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modifier l'entrée"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FAFAFA">
    <StackPanel Margin="18">

        <TextBlock Text="Modifier l'entrée" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>

        <TextBlock Text="Tâche" Margin="0,0,0,4"/>
        <ComboBox x:Name="TaskBox" IsEditable="True" Padding="6,4" Margin="0,0,0,12"/>

        <TextBlock Text="Date" Margin="0,0,0,4"/>
        <DatePicker x:Name="DateBox" Margin="0,0,0,12"/>

        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Début (hh:mm)" Margin="0,0,0,4"/>
                <TextBox x:Name="StartBox" Padding="6,4"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Fin (hh:mm)" Margin="0,0,0,4"/>
                <TextBox x:Name="EndBox" Padding="6,4"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="DurationText" Foreground="#555" Margin="0,4,0,0"/>
        <TextBlock x:Name="ErrorText" Foreground="#C0392B" TextWrapping="Wrap"
                   Margin="0,6,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Annuler" Padding="14,5" Margin="0,0,8,0"
                    IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Enregistrer" Padding="14,5" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
